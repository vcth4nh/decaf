Set Shell "bash"
Set FontFamily "DejaVu Sans Mono"
Set FontSize 20
Set Width 1200
Set Height 760
Set Theme "Catppuccin Mocha"
Set Padding 24
Set TypingSpeed 60ms
Set PlaybackSpeed 1
Set Framerate 20
Set CursorBlink false
Set WaitTimeout 60s

Hide
Type@1ms "export PS1='$ ' HISTFILE=/dev/null; unset PROMPT_COMMAND; clear"
Enter
Sleep 500ms
